<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;</TargetFrameworks>
        <RootNamespace>Gurux.Common</RootNamespace>
        <AssemblyName>Gurux.Common</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <PropertyGroup>
        <Version Condition=" '$(BUILD_BUILDNUMBER)' == '' ">0.0.1-local</Version>
        <Version Condition=" '$(BUILD_BUILDNUMBER)' != '' ">$(BUILD_BUILDNUMBER)</Version>
    </PropertyGroup>
    <PropertyGroup>
        <Company>Gurux Ltd</Company>
        <Authors>Gurux Ltd</Authors>
        <Copyright>Copyright (c) 1998-2026 Gurux Ltd. All rights reserved.</Copyright>
        <Description>Gurux.Common class implements interfaces that are needed for Gurux Media components and Gurux Device Framework.</Description>
        <PackageId>Gurux.Common</PackageId>
        <PackageProjectUrl>https://www.gurux.fi/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/gurux/gurux.common</RepositoryUrl>
        <PackageTags>AMR, AMI IOT</PackageTags>
        <PackageIcon>Gurux.Common.png</PackageIcon>
        <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Gurux.Common.png" />
        <None Include="Gurux.Common.png" Pack="true" PackagePath="/" />
        <None Include="../LICENSE" Pack="true" PackagePath="/" />
        <None Include="../LICENSES/LicenseRef-Gurux-Commercial" Pack="true" PackagePath="LICENSES/" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="Properties/Resources.Designer.cs" />
        <EmbeddedResource Update="Properties/Resources.resx">
            <StronglyTypedLanguage>C#</StronglyTypedLanguage>
            <StronglyTypedClassName>Resources</StronglyTypedClassName>
            <StronglyTypedNamespace>Gurux.Common.Properties</StronglyTypedNamespace>
            <StronglyTypedFileName>$(IntermediateOutputPath)Resources.Designer.cs</StronglyTypedFileName>
        </EmbeddedResource>
    </ItemGroup>
</Project>
